# Placeholder values — replace with a read-only VRLI service account.
ARIALOG_HOST=vrli.example.local
ARIALOG_PORT=9543
ARIALOG_USERNAME=svc-arialog-ro@example.local
ARIALOG_PASSWORD=changeme
ARIALOG_PROVIDER=ActiveDirectory     # Local | ActiveDirectory | vIDM
ARIALOG_VERIFY_SSL=true
# ARIALOG_CA_BUNDLE=/etc/ssl/certs/internal-ca.pem
# ARIALOG_TRUST_ENV=false            # true only if VRLI must be reached through HTTP(S)_PROXY
ARIALOG_TRANSPORT=stdio              # stdio | http
# --- HTTP transport ---------------------------------------------------------
# ARIALOG_HTTP_HOST=127.0.0.1        # non-loopback (e.g. 0.0.0.0) requires token or ldap auth
# ARIALOG_HTTP_PORT=8000
# ARIALOG_HTTP_AUTH_TOKEN=           # >= 16 chars; generate: openssl rand -hex 32
# ARIALOG_HTTP_ALLOW_UNAUTHENTICATED=false   # true only behind an authenticating proxy
# --- resilience (defaults shown) --------------------------------------------
# ARIALOG_REQUEST_TIMEOUT_S=45       # must exceed QUERY_TIMEOUT_MS
# ARIALOG_QUERY_TIMEOUT_MS=30000
# ARIALOG_RETRIES=3
# ARIALOG_BACKOFF_BASE_S=0.5
# ARIALOG_BACKOFF_MAX_S=10
# ARIALOG_USE_TLS=true             # https to VRLI
# ARIALOG_MAX_CONCURRENCY=4
# ARIALOG_BREAKER_FAILURES=5
# ARIALOG_BREAKER_COOLDOWN_S=30
# ARIALOG_LOGIN_COOLDOWN_S=60         # after a rejected VRLI login
# --- response limits (what the LLM may receive; defaults shown) -----------
# ARIALOG_MAX_EVENTS=200
# ARIALOG_MAX_BYTES=60000
# ARIALOG_MAX_TEXT_CHARS=1000
# ARIALOG_SIGNATURE_SCAN_LIMIT=2000
# ARIALOG_MAX_BINS=144
# ARIALOG_MAX_WINDOW_HOURS=72
# ARIALOG_SPIKE_ZSCORE=3
# ARIALOG_LOG_LEVEL=INFO
# --- LDAP mode (ARIALOG_HTTP_AUTH_MODE=ldap; same formats as ariaops-mcp's ARIAOPS_LDAP_*) ---
# Each caller's own credentials are used for VRLI; USERNAME/PASSWORD above are then not needed.
# ARIALOG_HTTP_AUTH_MODE=ldap        # none | token | ldap
# ARIALOG_LDAP_SERVER_URI=ldaps://dc01.example.local:636
# ARIALOG_LDAP_USER_DN_TEMPLATE={username}@example.local
# ARIALOG_LDAP_USER_SEARCH_BASE=dc=example,dc=local
# ARIALOG_LDAP_GROUP_ROLE_MAP={"vrops-ops": {"role": "ops"}, "vrops-se": {"role": "country", "country": "SE"}}
# ARIALOG_DEFAULT_ROLE=              # required only without a group map; granted to every bound user
# ARIALOG_LDAP_CA_CERT_FILE=/etc/ssl/certs/internal-ca.pem
# ARIALOG_LDAP_VERIFY_TLS=true       # ldaps:// is mandatory while true
# ARIALOG_LDAP_CACHE_TTL=300
# ARIALOG_LDAP_BIND_TIMEOUT=10
# ARIALOG_LDAP_MAX_FAILED_BINDS=5
# ARIALOG_LDAP_FAILED_BIND_COOLDOWN_S=300
# ARIALOG_LDAP_VRLI_USERNAME_TEMPLATE={username}
# ARIALOG_MAX_USER_SESSIONS=256
