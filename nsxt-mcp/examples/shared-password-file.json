{
  "mode": "shared",
  "targets": {
    "site-a": {
      "url": "https://nsx-a.example.test",
      "ca_bundle": "/absolute/path/to/config/nsx-ca.pem",
      "credential_profile": "network-reader"
    },
    "site-b": {
      "url": "https://nsx-b.example.test",
      "ca_bundle": "/absolute/path/to/config/nsx-ca.pem",
      "credential_profile": "network-reader"
    }
  },
  "credential_profiles": {
    "network-reader": {
      "username_env": "NSXT_SERVICE_USER",
      "password_file": "/absolute/path/to/secrets/nsx-reader.password"
    }
  }
}
