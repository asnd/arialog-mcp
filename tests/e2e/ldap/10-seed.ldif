# Test directory for the LDAP e2e (osixia/openldap, dc=example,dc=org). Placeholder passwords.
dn: ou=people,dc=example,dc=org
objectClass: organizationalUnit
ou: people

dn: ou=groups,dc=example,dc=org
objectClass: organizationalUnit
ou: groups

# alice: in the ops group, and a VRLI user -> full access, queries VRLI as herself
dn: uid=alice,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: alice
cn: Alice
sn: Ops
userPassword: pw-alice

# bob: valid directory user in no mapped group -> 401
dn: uid=bob,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: bob
cn: Bob
sn: Other
userPassword: pw-bob

# carol: mapped (country role) but not a VRLI user -> clean VRLI credentials error
dn: uid=carol,ou=people,dc=example,dc=org
objectClass: inetOrgPerson
uid: carol
cn: Carol
sn: Country
userPassword: pw-carol

dn: cn=arialog-ops,ou=groups,dc=example,dc=org
objectClass: groupOfUniqueNames
cn: arialog-ops
uniqueMember: uid=alice,ou=people,dc=example,dc=org

dn: cn=vrops-se,ou=groups,dc=example,dc=org
objectClass: groupOfUniqueNames
cn: vrops-se
uniqueMember: uid=carol,ou=people,dc=example,dc=org

dn: cn=wiki-users,ou=groups,dc=example,dc=org
objectClass: groupOfUniqueNames
cn: wiki-users
uniqueMember: uid=bob,ou=people,dc=example,dc=org
uniqueMember: uid=alice,ou=people,dc=example,dc=org
