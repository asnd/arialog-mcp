# Like AD: authenticated users may read the directory (needed for the memberOf lookup).
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by dn="cn=admin,dc=example,dc=org" write by anonymous auth by * none
olcAccess: {1}to * by dn="cn=admin,dc=example,dc=org" write by users read by * none
