# Unit-test image. Build context = repository root.
#   podman build --format docker -f Containerfile.test -t localhost/arialog-mcp-test:dev .
FROM docker.io/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PATH="/repo/.venv/bin:$PATH" \
    NO_PROXY=127.0.0.1,localhost \
    no_proxy=127.0.0.1,localhost \
    RUFF_CACHE_DIR=/tmp/ruff MYPY_CACHE_DIR=/tmp/mypy COVERAGE_FILE=/tmp/.coverage

RUN pip install --no-cache-dir uv==0.10.9 && useradd --create-home --uid 10001 tester
WORKDIR /repo
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
RUN uv sync --frozen --python 3.12 --no-managed-python      # includes the dev group
COPY tests ./tests
RUN chown -R tester:tester /repo
USER tester

# Lint, types, then tests with a coverage floor. No network is needed (ASGI in-process).
CMD ["sh", "-c", "set -e; \
 ruff check src tests; \
 mypy; \
 pytest -q -p no:cacheprovider --cov=arialog_mcp --cov-report=term-missing --cov-fail-under=90"]
